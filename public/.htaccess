# NewCareer – public/.htaccess
# Security headers and direct-access restrictions

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny direct access to config/ and src/
    RewriteRule ^(config|src)/ - [F,L]
</IfModule>

# Prevent directory listing
Options -Indexes

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options   "nosniff"
    Header always set X-Frame-Options          "SAMEORIGIN"
    Header always set X-XSS-Protection         "1; mode=block"
    Header always set Referrer-Policy          "strict-origin-when-cross-origin"
    Header always set Permissions-Policy       "geolocation=(), camera=(), microphone=()"
</IfModule>

# Deny direct access to PHP files inside config/ or src/ if they end up here
<FilesMatch "\.(env|log|sql|htpasswd|json|lock)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
